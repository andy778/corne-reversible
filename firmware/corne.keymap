/*
 * Starter keymap for the reversible Corne (42 keys, 3x6+3).
 *
 * Layers:
 *   0 default  QWERTY
 *   1 lower    numbers, arrows          (hold left thumb, LOWER)
 *   2 raise    symbols                  (hold right thumb, RAISE)
 *   3 adjust   Bluetooth, outputs, reset, Studio unlock
 *              reach it with LOWER held + the bottom-left key (&mo 3 on lower)
 *
 * Host layout: the computer must be set to the Finnish/Swedish keyboard layout
 * (ISO). Keycodes below are the US-HID positions that produce the Nordic
 * characters under that layout; the FI_* defines name them.
 *
 * Positions follow the stock corne shield: 6 keys per side per row,
 * then 3 thumb keys per side. 42 bindings per layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* Finnish/Swedish host layout: character -> key position */
#define FI_ARNG  LBKT           /* å */
#define FI_ADIA  SQT            /* ä */
#define FI_ODIA  SEMI           /* ö */
#define FI_EURO  RA(E)          /* € (AltGr+E) */
#define FI_MINUS FSLH           /* - */
#define FI_UNDS  LS(FSLH)       /* _ */
#define FI_PLUS  MINUS          /* + */
#define FI_QUES  LS(MINUS)      /* ? */
#define FI_BSLH  RA(MINUS)      /* \ */
#define FI_EQL   LS(N0)         /* = */
#define FI_EXCL  LS(N1)         /* ! */
#define FI_DQUO  LS(N2)         /* " */
#define FI_AT    RA(N2)         /* @ */
#define FI_HASH  LS(N3)         /* # */
#define FI_DLR   RA(N4)         /* $ */
#define FI_PERC  LS(N5)         /* % */
#define FI_AMPR  LS(N6)         /* & */
#define FI_SLSH  LS(N7)         /* / */
#define FI_LPRN  LS(N8)         /* ( */
#define FI_RPRN  LS(N9)         /* ) */
#define FI_LCBR  RA(N7)         /* { */
#define FI_LBRC  RA(N8)         /* [ */
#define FI_RBRC  RA(N9)         /* ] */
#define FI_RCBR  RA(N0)         /* } */
#define FI_QUOT  NUHS           /* ' */
#define FI_ASTR  LS(NUHS)       /* * */
#define FI_LABK  NUBS           /* < */
#define FI_RABK  LS(NUBS)       /* > */
#define FI_PIPE  RA(NUBS)       /* | */
#define FI_SCLN  LS(COMMA)      /* ; */
#define FI_COLN  LS(DOT)        /* : */
#define FI_SECT  GRAVE          /* § */

/ {
        macros {
                /* ^ ~ ` are dead keys on the Nordic layout; tap space to emit the character. */
                ZMK_MACRO(fi_circ,  wait-ms = <0>; tap-ms = <10>; bindings = <&kp LS(RBKT) &kp SPACE>;)
                ZMK_MACRO(fi_tild,  wait-ms = <0>; tap-ms = <10>; bindings = <&kp RA(RBKT) &kp SPACE>;)
                ZMK_MACRO(fi_grave, wait-ms = <0>; tap-ms = <10>; bindings = <&kp LS(EQUAL) &kp SPACE>;)
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  Å   |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ö  |  Ä   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  -  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE | BSPC |
                        bindings = <
   &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U    &kp I     &kp O   &kp P       &kp FI_ARNG
   &kp LCTRL &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J    &kp K     &kp L   &kp FI_ODIA &kp FI_ADIA
   &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B     &kp N   &kp M    &kp COMMA &kp DOT &kp FI_MINUS &kp ESC
                  &kp LGUI &mo 1 &kp SPACE     &kp RET &mo 2 &kp BSPC
                        >;
                };

                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | CTRL |     |     |     |     |     |   | LFT | DWN |  UP | RGT |     |      |
// | ADJ  |     |     |     |     |     |   | HOME| PGDN| PGUP| END |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT  |
                        bindings = <
   &kp TAB   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
   &kp LCTRL &trans    &trans    &trans    &trans    &trans      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans   &trans
   &mo 3     &trans    &trans    &trans    &trans    &trans      &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans   &trans
                                    &kp LGUI  &trans    &kp SPACE      &kp RET   &trans    &kp LALT
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |  €  |  "  |  '  |  <  |  >  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |  §  |  ?  |  /  |  :  |  ;  |   |  _  |  +  |  {  |  }  |  |  |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT  |
                        bindings = <
   &kp TAB   &kp FI_EXCL &kp FI_AT   &kp FI_HASH &kp FI_DLR  &kp FI_PERC    &fi_circ     &kp FI_AMPR &kp FI_ASTR &kp FI_LPRN &kp FI_RPRN &kp BSPC
   &kp LCTRL &kp FI_EURO &kp FI_DQUO &kp FI_QUOT &kp FI_LABK &kp FI_RABK    &kp FI_MINUS &kp FI_EQL  &kp FI_LBRC &kp FI_RBRC &kp FI_BSLH &fi_grave
   &kp LSHFT &kp FI_SECT &kp FI_QUES &kp FI_SLSH &kp FI_COLN &kp FI_SCLN    &kp FI_UNDS  &kp FI_PLUS &kp FI_LCBR &kp FI_RCBR &kp FI_PIPE &fi_tild
                                    &kp LGUI  &trans    &kp SPACE      &kp RET   &trans    &kp LALT
                        >;
                };

                adjust_layer {
                        display-name = "Adjust";
// -----------------------------------------------------------------------------------------
// -----------------------------------------------------------------------------------------
// | STUDIO | SEL0 | SEL1 | SEL2 | SEL3 | SEL4 |   | PRV  | NXT  | USB  | BLE  | TOG  |      |
// | CLR    |      |      |      |      |      |   |      |      |      |      |      |      |
// | CLR ALL|      |      |      |      |      |   |      |      |      |      |      |      |
//                    | BOOT |      |      |   |      |      | RESET |
// studio_unlock: press once before Studio can edit the keymap (needed with locking on).
// CLR ALL drops every bond on every profile; RESET reboots. Both are kept off the home rows.
                        bindings = <
   &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &bt BT_PRV &bt BT_NXT &out OUT_USB &out OUT_BLE &out OUT_TOG &trans
   &bt BT_CLR &trans   &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans   &trans
   &bt BT_CLR_ALL &trans &trans  &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans   &trans
                                    &bootloader &trans  &trans     &trans    &trans    &sys_reset
                        >;
                };
        };
};
