(footprint "corne_reversible:SW_MX_Choc_Hotswap_Reversible"
	(layer "F.Cu")
	(at 35.0 60.0)
	(descr "Reversible hot-swap footprint for Kailh MX (CPG151101S11) OR Kailh Choc (CPG135001S30) sockets on either face. MX pins on the +y half (MX switch rotated 180 deg, south-facing), Choc pins on the -y half. 5.0 mm centre hole for Choc V2. Pad 1 = column side, pad 2 = diode side. MX pads adapted from ceoloide/ergogen-footprints switch_mx (c) 2023 Marco Massarelli, MIT; see THIRD_PARTY.md.")
	(tags "keyboard switch hotswap MX Choc reversible kailh")
	(property "Reference" "SW1" (at 0 -8.6 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
